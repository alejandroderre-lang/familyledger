# Copy this file to .env.local and fill in the values from your Supabase project.
# .env.local is gitignored — never commit real keys.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NOTE: ANTHROPIC_API_KEY is NOT set here. It lives only in the Supabase
# dashboard secrets (used by the parse-receipt edge function), never client-side.
